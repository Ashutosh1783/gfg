#include <bits/stdc++.h>
using namespace std;
int secondfreq(int arr[]){
    //for frequency
     unordered_map<int, int> freq;
    for(int i=0;i<7;i++)
    {
        freq[arr[i]]++;
    }
    int first=0;
    int second=0;
    for(auto it : freq)
    {
        if(it.second>first)
        {
            first=it.second;
            second=first;
        }
        else if(it.second<first && it.second>second)
        {
              second = it.second;
        }
    }
    // Second frequency wala element find karo
    for(int i = 0; i < 7; i++)
    {
        if(freq[arr[i]] == second)
        {
            return arr[i];
        }
    }

    return -1;
    
}
int main()
{
   int arr[]={1,3,2,1,1,2,4};
    //vector<int>ans;
    cout<<secondfreq(arr);
    return 0;
}
