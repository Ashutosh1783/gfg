class Solution {
  public:
    int maxDepth(Node *root) {
        // code here
        if(root==NULL)
        {
            return 0;
        }
        //left depth 
        int left=maxDepth(root->left);
        //right depth 
        int left=maxDepth(root->left);
        
        return max(left,right)+1;
    }
};
